<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" prefHeight="900.0" prefWidth="1600.0" styleClass="home-screen" stylesheets="@inventario.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.doldom.farmacia.presentation.views.inventario.InventarioController">

    <fx:include source="/com/doldom/farmacia/presentation/components/inventory/sidebar.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0"/>

    <VBox spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="24.0" left="30.0" right="30.0" top="14.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-shell,inventory-search-shell">
                <Label styleClass="icon-mdl,top-icon" text="&#xE721;"/>
                <TextField promptText="Buscar inventario..." styleClass="search-field"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="icon-mdl,top-icon-btn" text="&#xE7F4;"/>
            <Label styleClass="icon-mdl,top-icon-btn" text="&#xE713;"/>
            <Label styleClass="icon-mdl,top-icon-btn" text="&#xE897;"/>
            <Region styleClass="inventory-v-sep"/>
            <VBox alignment="CENTER_RIGHT">
                <Label styleClass="inventory-branch-name" text="Farmacia A-12"/>
                <Label styleClass="inventory-branch-sub" text="Sucursal principal"/>
            </VBox>
            <StackPane styleClass="inventory-branch-icon-shell">
                <Label styleClass="icon-mdl,inventory-branch-icon" text="&#xE7F1;"/>
            </StackPane>
        </HBox>

        <HBox spacing="18.0">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label styleClass="inventory-main-title" text="Inventario de stock"/>
                <Label maxWidth="760.0" styleClass="inventory-main-sub"
                       text="Gestiona los suministros de tu farmacia con precision. Monitorea niveles de stock, fechas de vencimiento y el flujo de reposicion."
                       wrapText="true"/>
            </VBox>
            <HBox spacing="12.0">
                <HBox alignment="CENTER" spacing="8.0" styleClass="inventory-action-muted">
                    <Label styleClass="icon-mdl,inventory-action-icon" text="&#xE71C;"/>
                    <Label styleClass="inventory-action-muted-text" text="Filtros&#10;avanzados"/>
                </HBox>
                <HBox alignment="CENTER" spacing="8.0" styleClass="inventory-action-primary">
                    <Label styleClass="icon-mdl,inventory-action-plus" text="&#xE710;"/>
                    <Label styleClass="inventory-action-primary-text" text="Agregar&#10;producto"/>
                </HBox>
            </HBox>
        </HBox>

        <HBox spacing="14.0">
            <VBox spacing="16.0" styleClass="inventory-health-card" HBox.hgrow="ALWAYS">
                <Label styleClass="inventory-health-title" text="Salud de inventario"/>
                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                    <Label styleClass="inventory-health-value" text="94.2%"/>
                    <Label styleClass="inventory-health-delta" text="↗ +2.4%"/>
                </HBox>
                <HBox spacing="6.0">
                    <Region styleClass="inventory-health-bar-main"/>
                    <Region styleClass="inventory-health-bar-secondary"/>
                    <Region styleClass="inventory-health-bar-track"/>
                </HBox>
            </VBox>

            <VBox spacing="14.0" styleClass="inventory-lowstock-card">
                <Label styleClass="icon-mdl,inventory-lowstock-icon" text="&#xE7BA;"/>
                <Label fx:id="stockBajoValue" styleClass="inventory-lowstock-value" text="12"/>
                <Label styleClass="inventory-lowstock-label" text="STOCK BAJO"/>
            </VBox>

            <VBox spacing="14.0" styleClass="inventory-expiry-card">
                <Label styleClass="icon-mdl,inventory-expiry-icon" text="&#xE787;"/>
                <Label fx:id="proximosVencerValue" styleClass="inventory-expiry-value" text="08"/>
                <Label styleClass="inventory-expiry-label" text="PROXIMOS A VENCER"/>
            </VBox>
        </HBox>

        <VBox spacing="0.0" styleClass="inventory-table-card" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" styleClass="inventory-table-top">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label styleClass="inventory-table-title" text="Inventario activo"/>
                    <Label styleClass="inventory-table-chip" text="482 SKU TOTAL"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="inventory-sort-label" text="Ordenado por:"/>
                <Label styleClass="inventory-sort-value" text="Nombre de producto"/>
            </HBox>

            <HBox spacing="0.0" styleClass="inventory-table-head">
                <Label styleClass="inventory-col,header,col-name" text="NOMBRE PRODUCTO"/>
                <Label styleClass="inventory-col,header,col-cat" text="CATEGORIA"/>
                <Label styleClass="inventory-col,header,col-stock" text="NIVEL STOCK"/>
                <Label styleClass="inventory-col,header,col-price" text="PRECIO"/>
                <Label styleClass="inventory-col,header,col-exp" text="VENCIMIENTO"/>
            </HBox>

            <VBox spacing="1.0" VBox.vgrow="ALWAYS">
                <HBox spacing="0.0" styleClass="inventory-row">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="inventory-col,col-name">
                        <StackPane styleClass="inventory-prod-icon-shell">
                            <Label styleClass="icon-mdl,inventory-prod-icon" text="&#xE8B0;"/>
                        </StackPane>
                        <VBox>
                            <Label styleClass="inventory-prod-name" text="Amoxicilina 500mg"/>
                            <Label styleClass="inventory-prod-sku" text="SKU: AMX-2938"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="inventory-col,col-cat">
                        <Label styleClass="inventory-cat-chip" text="Antibioticos"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="inventory-col,col-stock">
                        <Label styleClass="inventory-stock-value" text="1,240 Unidades"/>
                        <ProgressBar progress="0.82" styleClass="inventory-stock-progress"/>
                    </HBox>
                    <Label styleClass="inventory-col,col-price,inventory-price" text="Q12.50"/>
                    <Label styleClass="inventory-col,col-exp,inventory-exp-date" text="14 Oct, 2025"/>
                </HBox>

                <HBox spacing="0.0" styleClass="inventory-row,inventory-row-warn">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="inventory-col,col-name">
                        <StackPane styleClass="inventory-prod-icon-shell,warn">
                            <Label styleClass="icon-mdl,inventory-prod-icon,warn" text="&#xE7BA;"/>
                        </StackPane>
                        <VBox>
                            <Label styleClass="inventory-prod-name" text="Lisinopril 10mg"/>
                            <Label styleClass="inventory-prod-sku" text="SKU: LIS-0041"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="inventory-col,col-cat">
                        <Label styleClass="inventory-cat-chip,neutral" text="Cardiovascular"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="inventory-col,col-stock">
                        <Label styleClass="inventory-stock-value,warn" text="42 Unidades"/>
                        <ProgressBar progress="0.15" styleClass="inventory-stock-progress,warn"/>
                    </HBox>
                    <Label styleClass="inventory-col,col-price,inventory-price" text="Q8.75"/>
                    <Label styleClass="inventory-col,col-exp,inventory-exp-date" text="02 Ene, 2025"/>
                </HBox>

                <HBox spacing="0.0" styleClass="inventory-row">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="inventory-col,col-name">
                        <StackPane styleClass="inventory-prod-icon-shell">
                            <Label styleClass="icon-mdl,inventory-prod-icon" text="&#xE7B9;"/>
                        </StackPane>
                        <VBox>
                            <Label styleClass="inventory-prod-name" text="Atorvastatina 40mg"/>
                            <Label styleClass="inventory-prod-sku" text="SKU: ATR-8821"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="inventory-col,col-cat">
                        <Label styleClass="inventory-cat-chip" text="Colesterol"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="inventory-col,col-stock">
                        <Label styleClass="inventory-stock-value" text="850 Unidades"/>
                        <ProgressBar progress="0.62" styleClass="inventory-stock-progress"/>
                    </HBox>
                    <Label styleClass="inventory-col,col-price,inventory-price" text="Q45.00"/>
                    <Label styleClass="inventory-col,col-exp,inventory-exp-date" text="19 May, 2026"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_LEFT" styleClass="inventory-pagination">
                <Label styleClass="inventory-pagination-text" text="Mostrando 1 a 3 de 482 productos"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10.0">
                    <Label styleClass="inventory-page-btn,active" text="1"/>
                    <Label styleClass="inventory-page-btn" text="2"/>
                    <Label styleClass="inventory-page-btn" text="3"/>
                </HBox>
            </HBox>
        </VBox>
    </VBox>

    <VBox spacing="14.0" styleClass="inventory-flow-panel" AnchorPane.bottomAnchor="22.0" AnchorPane.rightAnchor="26.0">
        <HBox alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="icon-mdl,inventory-flow-icon" text="&#xE9D2;"/>
                <Label styleClass="inventory-flow-title" text="Flujo de inventario"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="icon-mdl,inventory-flow-close" text="&#xE711;"/>
        </HBox>
        <HBox>
            <Label styleClass="inventory-flow-label" text="Promedio diario"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="inventory-flow-value" text="142"/>
        </HBox>
        <HBox>
            <Label styleClass="inventory-flow-label" text="Frecuencia de reposicion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="inventory-flow-value" text="4.2 dias"/>
        </HBox>
        <Region styleClass="inventory-flow-sep"/>
        <Label styleClass="inventory-flow-btn" text="Ver reporte completo"/>
    </VBox>
</AnchorPane>
