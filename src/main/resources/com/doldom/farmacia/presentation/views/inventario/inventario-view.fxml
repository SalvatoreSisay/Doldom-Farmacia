<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" prefHeight="900.0" prefWidth="1600.0" styleClass="home-screen" stylesheets="@inventario.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.doldom.farmacia.presentation.views.inventario.InventarioController">

    <fx:include source="/com/doldom/farmacia/presentation/components/inventory/sidebar.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0"/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="inventory-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox minHeight="980.0" spacing="18.0">
                <padding>
                    <Insets bottom="36.0" left="30.0" right="30.0" top="14.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <HBox fx:id="searchShell" alignment="CENTER_LEFT" spacing="10.0" styleClass="search-shell,inventory-search-shell">
                        <Label styleClass="icon-mdl,top-icon" text="&#xE721;"/>
                        <TextField fx:id="searchField" promptText="Buscar por nombre o SKU..." styleClass="search-field"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="icon-mdl,top-icon-btn" text="&#xE7F4;"/>
                    <Label styleClass="icon-mdl,top-icon-btn" text="&#xE713;"/>
                    <Label styleClass="icon-mdl,top-icon-btn" text="&#xE897;"/>
                    <Region styleClass="inventory-v-sep"/>
                    <VBox alignment="CENTER_RIGHT">
                        <Label styleClass="inventory-branch-name" text="Farmacia A-12"/>
                        <Label styleClass="inventory-branch-sub" text="Sucursal principal"/>
                    </VBox>
                    <StackPane styleClass="inventory-branch-icon-shell">
                        <Label styleClass="icon-mdl,inventory-branch-icon" text="&#xE7F1;"/>
                    </StackPane>
                </HBox>

                <HBox spacing="18.0">
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="inventory-main-title" text="Inventario de stock"/>
                        <Label maxWidth="760.0" styleClass="inventory-main-sub"
                               text="Gestiona los suministros de tu farmacia con precision. Monitorea niveles de stock, fechas de vencimiento y el flujo de reposicion."
                               wrapText="true"/>
                    </VBox>
                    <HBox spacing="12.0">
                        <HBox alignment="CENTER" spacing="8.0" styleClass="inventory-action-muted">
                            <Label styleClass="icon-mdl,inventory-action-icon" text="&#xE71C;"/>
                            <Label styleClass="inventory-action-muted-text" text="Filtros&#10;avanzados"/>
                        </HBox>
                        <HBox alignment="CENTER" spacing="8.0" styleClass="inventory-action-primary">
                            <Label styleClass="icon-mdl,inventory-action-plus" text="&#xE710;"/>
                            <Label styleClass="inventory-action-primary-text" text="Agregar&#10;producto"/>
                        </HBox>
                    </HBox>
                </HBox>

                <HBox spacing="14.0">
                    <VBox spacing="16.0" styleClass="inventory-health-card" onMouseClicked="#onShowInventoryHealth" HBox.hgrow="ALWAYS">
                        <Label styleClass="inventory-health-title" text="Salud de inventario"/>
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                            <Label fx:id="inventoryHealthValue" styleClass="inventory-health-value" text="0%"/>
                            <Label fx:id="inventoryHealthDelta" styleClass="inventory-health-delta" text="+0"/>
                        </HBox>
                        <ProgressBar fx:id="inventoryHealthProgress" progress="0.0" styleClass="inventory-health-progress"/>
                    </VBox>

                    <VBox spacing="14.0" styleClass="inventory-lowstock-card" onMouseClicked="#onShowLowStock">
                        <Label styleClass="icon-mdl,inventory-lowstock-icon" text="&#xE7BA;"/>
                        <Label fx:id="stockBajoValue" styleClass="inventory-lowstock-value" text="0"/>
                        <Label styleClass="inventory-lowstock-label" text="STOCK BAJO"/>
                    </VBox>

                    <VBox spacing="14.0" styleClass="inventory-expiry-card" onMouseClicked="#onShowExpiringSoon">
                        <Label styleClass="icon-mdl,inventory-expiry-icon" text="&#xE787;"/>
                        <Label fx:id="proximosVencerValue" styleClass="inventory-expiry-value" text="0"/>
                        <Label styleClass="inventory-expiry-label" text="PROXIMOS A VENCER"/>
                    </VBox>
                </HBox>

                <VBox spacing="0.0" styleClass="inventory-table-card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" styleClass="inventory-table-top">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="inventory-table-title" text="Inventario activo"/>
                            <Label fx:id="totalProductosValue" styleClass="inventory-table-chip" text="0 SKU TOTAL"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label styleClass="inventory-sort-label" text="Ordenado por:"/>
                        <Label styleClass="inventory-sort-value" text="Nombre de producto"/>
                    </HBox>

                    <HBox spacing="0.0" styleClass="inventory-table-head">
                        <Label styleClass="inventory-col,header,col-name" text="NOMBRE PRODUCTO"/>
                        <Label styleClass="inventory-col,header,col-cat" text="CATEGORIA"/>
                        <Label styleClass="inventory-col,header,col-stock" text="NIVEL STOCK"/>
                        <Label styleClass="inventory-col,header,col-price" text="PRECIO"/>
                        <Label styleClass="inventory-col,header,col-exp" text="VENCIMIENTO"/>
                    </HBox>

                    <VBox fx:id="inventoryRows" spacing="1.0" VBox.vgrow="ALWAYS"/>

                    <HBox alignment="CENTER_LEFT" styleClass="inventory-pagination">
                        <Label fx:id="paginationText" styleClass="inventory-pagination-text" text="Mostrando 0 productos"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="10.0">
                            <Label fx:id="pageOne" styleClass="inventory-page-btn,active" onMouseClicked="#onGoPageOne" text="1"/>
                            <Label fx:id="pageTwo" styleClass="inventory-page-btn" onMouseClicked="#onGoPageTwo" text="2"/>
                            <Label fx:id="pageThree" styleClass="inventory-page-btn" onMouseClicked="#onGoPageThree" text="3"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <VBox fx:id="inventoryFlowPanel" spacing="14.0" styleClass="inventory-flow-panel" AnchorPane.bottomAnchor="22.0" AnchorPane.rightAnchor="26.0">
        <HBox alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="icon-mdl,inventory-flow-icon" text="&#xE9D2;"/>
                <Label styleClass="inventory-flow-title" text="Flujo de inventario"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="icon-mdl,inventory-flow-close" onMouseClicked="#onToggleFlowPanel" text="&#xE711;"/>
        </HBox>
        <HBox>
            <Label styleClass="inventory-flow-label" text="Promedio diario"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="flowDailyValue" styleClass="inventory-flow-value" text="0"/>
        </HBox>
        <HBox>
            <Label styleClass="inventory-flow-label" text="Frecuencia de reposicion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="flowFrequencyValue" styleClass="inventory-flow-value" text="0 dias"/>
        </HBox>
        <Region styleClass="inventory-flow-sep"/>
        <Label styleClass="inventory-flow-btn" text="Ver reporte completo"/>
    </VBox>

    <HBox fx:id="inventoryFlowTab" alignment="CENTER" spacing="8.0" managed="false" visible="false" styleClass="inventory-flow-tab" onMouseClicked="#onToggleFlowPanel" AnchorPane.bottomAnchor="24.0" AnchorPane.rightAnchor="26.0">
        <Label styleClass="icon-mdl,inventory-flow-tab-icon" text="&#xE9D2;"/>
        <Label styleClass="inventory-flow-tab-text" text="Flujo"/>
    </HBox>
</AnchorPane>
